# MongoDB connection string - replace with your MongoDB Atlas URI or local URI
MONGO_URI=mongodb://localhost:27017/submitbridge

# JWT secret key - use any long random string for signing tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Port on which the server will run
PORT=5000

# Client frontend URL for generating student submission links and QR codes
CLIENT_URL=http://localhost:3000

