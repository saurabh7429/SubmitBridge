# ==========================================
# SubmitBridge - Git Ignore Configuration
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit credentials)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# IDE & Agent Configurations (contains MCP PATs / session tokens)
.agents/
.vscode/
.idea/

# Dependencies
node_modules/
**/node_modules/

# Production builds
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / Test data & Playwright snapshots
.playwright-mcp/
.system_generated/
server/uploads/
server/data/
*.pdf
student_orbit_assignment.docx
student_orbit_assignment.pdf

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
