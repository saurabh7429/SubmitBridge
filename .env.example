# ==============================================================================
# SubmitBridge — Environment Configuration Template
# Copy this file to .env (or server/.env) and fill in your actual credentials.
# DO NOT commit real secrets or API keys to version control.
# ==============================================================================

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Supabase (PostgreSQL Database & File Storage)
# Obtain these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token

# Phase 2: Azure OpenAI Service (gpt-5-mini)
# Obtain these from your Azure OpenAI resource deployment overview
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# Phase 3: Sapling AI Content Detector (Optional)
# Comma-separated keys for round-robin rotation across multiple free-tier accounts
SAPLING_API_KEYS=key_1_here,key_2_here,key_3_here

